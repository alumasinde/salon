# Salon application environment. Copy to .env and fill in real values.
APP_NAME="Zuri Beauty Lounge"
APP_DEBUG=false
APP_KEY=
APP_TIMEZONE=Africa/Nairobi

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=salon
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Session hardening
SESSION_NAME=salon_admin
SESSION_IDLE_SECONDS=1800
SESSION_MAX_SECONDS=28800

# Booking SMS gateway (values here are defaults; endpoint and sender are
# editable in the admin panel and stored in the database).
SMS_ENABLED=false
SMS_ENDPOINT=https://sms.textsms.co.ke/api/services/sendsms/
SMS_METHOD=GET
SMS_KEY=
SMS_PARTNER_ID=
SMS_SHORTCODE=
SMS_TIMEOUT=8
